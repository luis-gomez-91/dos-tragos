---
---

<section class="max-w-6xl mx-auto px-6 mt-24">
    <h2 class="section-title section-title-wrap text-4xl md:text-5xl text-cream py-12 tracking-wider">Productos estrella</h2>
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
        <article class="relative aspect-[3/4] rounded-2xl overflow-hidden group">
            <img src="/img/galeria/sangria.webp" alt="Sangría" loading="lazy" class="absolute inset-0 w-full h-full object-cover transition-transform duration-700 group-hover:scale-105">
            <div class="absolute inset-0 bg-gradient-to-t from-surface via-surface/40 to-transparent"></div>
            <div class="absolute bottom-0 left-0 right-0 p-8 border-b-2 border-gold/30 pb-8">
                <h3 class="text-2xl font-medium text-cream tracking-wide">Sangría</h3>
                <p class="mt-2 text-zinc-400 text-sm leading-7">Vino tinto seleccionado con frutas frescas y especias. Perfecta para compartir.</p>
            </div>
        </article>
        <article class="relative lg:col-span-2 aspect-[3/4] lg:aspect-auto lg:min-h-[500px] rounded-2xl overflow-hidden group">
            <img src="/img/galeria/mojito.webp" alt="Mojito" loading="lazy" class="absolute inset-0 w-full h-full object-cover transition-transform duration-700 group-hover:scale-105">
            <div class="absolute inset-0 bg-gradient-to-t from-surface via-surface/30 to-transparent"></div>
            <div class="absolute bottom-0 left-0 right-0 p-8 lg:p-12 border-b-2 border-gold/30 pb-8 lg:pb-12">
                <h3 class="text-2xl lg:text-3xl font-medium text-cream tracking-wide">Mojito</h3>
                <p class="mt-2 text-zinc-400 text-sm lg:text-base leading-7 max-w-xl">El clásico cubano reinventado. Ron blanco, hierbabuena fresca, lima y soda. Refrescante para cualquier ocasión.</p>
            </div>
        </article>
        <article class="relative aspect-[3/4] rounded-2xl overflow-hidden group">
            <img src="/img/galeria/baileys.webp" alt="Crema de Baileys" loading="lazy" class="absolute inset-0 w-full h-full object-cover transition-transform duration-700 group-hover:scale-105">
            <div class="absolute inset-0 bg-gradient-to-t from-surface via-surface/40 to-transparent"></div>
            <div class="absolute bottom-0 left-0 right-0 p-8 border-b-2 border-gold/30 pb-8">
                <h3 class="text-2xl font-medium text-cream tracking-wide">Crema de Baileys</h3>
                <p class="mt-2 text-zinc-400 text-sm leading-7">Licor irlandés de crema y whisky con chocolate. Base perfecta para postres.</p>
            </div>
        </article>
    </div>
</section>