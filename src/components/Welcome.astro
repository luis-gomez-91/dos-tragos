---
---
<section class="hero relative min-h-[100vh] flex flex-col">
    <div class="absolute inset-0">
        <video 
            class="w-full h-full object-cover"
            autoplay loop muted playsinline
        >
            <source src="/video/welcome.mp4">
        </video>
        <div class="absolute inset-0 bg-surface/50"></div>
    </div>
    <div class="relative flex-1 flex flex-col items-center justify-center px-6 text-center">
        <h1 class="hero-title font-display text-5xl sm:text-6xl md:text-7xl lg:text-8xl text-cream tracking-[0.2em] md:tracking-[0.35em] font-light">
            DOS TRAGOS
        </h1>
        <p class="hero-subtitle mt-6 md:mt-8 text-zinc-400 text-sm md:text-base tracking-[0.3em] uppercase font-light">
            El arte del buen beber
        </p>
    </div>
    <div class="relative pb-8 flex justify-center" aria-hidden="true">
        <span class="w-px h-12 bg-white/30 rounded-full"></span>
    </div>
</section>
